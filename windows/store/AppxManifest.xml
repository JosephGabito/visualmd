<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">
  <!-- The package script replaces these three identity values with the exact
       values Partner Center assigns to the reserved Visual MD product. -->
  <Identity
    Name="VisualMD.StoreIdentity"
    Publisher="CN=VisualMDDevelopment"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Visual MD</DisplayName>
    <PublisherDisplayName>Visual MD Development</PublisherDisplayName>
    <Description>A local-first reader for folders of Markdown files.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="VisualMD"
      Executable="visualmd.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Visual MD"
        Description="A local-first reader for folders of Markdown files."
        BackgroundColor="#F6F3EC"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
    </Application>
  </Applications>

  <!-- Flutter's desktop host is a classic Win32 application. This capability
       is required to launch it, not permission to read arbitrary user files.
       Files and folders remain accessible only after the user chooses them. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
